* text=auto
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.glb binary
*.obj binary
*.fbx binary
*.uasset binary
*.umap binary
*.wav binary
# Large authored Unreal packages use Git LFS when created by the editor pipeline.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png binary
*.jpg binary
